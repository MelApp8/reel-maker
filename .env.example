# Copy this file to ".env" and fill in what you want. Everything is optional.

# Photos come from Wikipedia/Wikimedia Commons and Openverse: free, no key needed.
# Optional: AI-written hooks, captions and titles (https://console.anthropic.com). Costs a few cents a day.
ANTHROPIC_API_KEY=

# Country for Google Trends: US, IN, GB, CA, AU, DE, BR ...
TRENDS_GEO=US
REELS_PER_DAY=3
# Time the app makes new reels each day (24h clock). Leave empty to turn off.
DAILY_TIME=08:00
# Your social handle, e.g. @myreels, shown small at the bottom of every reel
HANDLE=
REEL_SECONDS=20

# Only trends about these subjects become reels (remove any you don't want)
CATEGORIES=geopolitics,football,entertainment,crime
# Voiceover reads each caption aloud (free). Voices: en-US-AndrewNeural, en-US-AriaNeural, en-IN-NeerjaNeural, en-GB-RyanNeural ...
VOICEOVER=on
VOICE=en-US-AndrewNeural
MUSIC_VOLUME=0.18
